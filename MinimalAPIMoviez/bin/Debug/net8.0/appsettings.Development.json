{
  "Name": "Erfan is on the Fire of DevelopMode",
  "OriginConf": {
    "AllowedOrigins": [
      "*"
    ],
    "AllowCredentials": true,
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "http://localhost:4852",
          "https://localhost:44369",
          "http://localhost:5053",
          "http://localhost:5059",
          "",
          "https://localhost:7153"
        ],
        "ValidIssuer": "dotnet-user-jwts"
      }
    }
  }
}